{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flowhub-review",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "assets": {"directory": "../netlify-review/public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name":"REVIEW_QUEUE","class_name":"ReviewQueue"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ReviewQueue"]}]
}
